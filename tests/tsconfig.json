{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "rootDir": "..",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@print/width": ["../shared/print/width"],
      "@print/document": ["../shared/print/document"],
      "@/lib/i18n/languages": ["../frontend/src/lib/i18n/languages"]
    }
  },
  "include": ["../tests/**/*", "../main/**/*", "../shared/**/*"]
}
